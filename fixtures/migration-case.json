{
  "rules": [
    {
      "id": "R-100",
      "work": "批量导出切换",
      "product": "Mercury",
      "feature": "bulk-export-mc",
      "source_ref": "release-4.5",
      "quote": "4.2 以下的旧网关，且已启用批量导出的租户需要完成批量导出迁移。",
      "conditions": [
        {
          "kind": "eq",
          "key": "product",
          "label": "产品",
          "expected": "Mercury",
          "source_ref": "release-4.5",
          "quote": "Mercury 旧网关租户适用本说明。"
        },
        {
          "kind": "eq",
          "key": "gateway",
          "label": "网关",
          "expected": "旧网关",
          "source_ref": "release-4.5",
          "quote": "4.2 以下的旧网关。"
        },
        {
          "kind": "version_lt",
          "key": "api",
          "label": "接口版本",
          "expected": "4.2",
          "source_ref": "release-4.5",
          "quote": "4.2 以下。"
        },
        {
          "kind": "feature",
          "key": "features",
          "label": "接口简称",
          "alias": "批量导出",
          "source_ref": "release-4.5",
          "quote": "且已启用批量导出。"
        }
      ]
    },
    {
      "id": "R-300",
      "work": "批量导出切换",
      "product": "Atlas",
      "feature": "bulk-export-atlas",
      "source_ref": "release-atlas-2.0",
      "quote": "Atlas 旧网关上启用批量导出的集成需要切换到新网关导出。",
      "conditions": [
        {
          "kind": "eq",
          "key": "product",
          "label": "产品",
          "expected": "Atlas",
          "source_ref": "release-atlas-2.0",
          "quote": "Atlas 产品的集成适用本说明。"
        },
        {
          "kind": "eq",
          "key": "gateway",
          "label": "网关",
          "expected": "旧网关",
          "source_ref": "release-atlas-2.0",
          "quote": "旧网关。"
        },
        {
          "kind": "feature",
          "key": "features",
          "label": "接口简称",
          "alias": "批量导出",
          "source_ref": "release-atlas-2.0",
          "quote": "启用批量导出。"
        }
      ]
    }
  ],
  "amendments": [
    {
      "id": "A-1",
