        "label": "托管客户",
        "expected": true,
        "source_ref": "bulletin-hosted",
        "quote": "托管客户例外。"
      }
    },
    {
      "id": "A-2",
      "rule_id": "R-300",
      "type": "撤回",
      "source_ref": "bulletin-withdraw",
      "quote": "撤回 Atlas 旧网关批量导出迁移要求，已发出的通知相应作废；其他产品说明不受影响。"
    }
